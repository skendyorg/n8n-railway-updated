{
	admin off
	email mozes@t-apps.nl
	auto_https disable_redirects
	# The private Access application protects TCP. Keep HTTPS on TCP only.
	servers {
		protocols h1 h2
	}
}

n8n.internal.t-apps.nl {
	tls {
		dns cloudflare {env.CF_DNS_API_TOKEN}
		resolvers 1.1.1.1 1.0.0.1
	}
	reverse_proxy n8n.railway.internal:5678 {
		header_up X-Forwarded-For {http.request.remote.host}
		header_up X-Forwarded-Host n8n.internal.t-apps.nl
		header_up X-Forwarded-Proto https
	}
}

uptime.internal.t-apps.nl {
	tls {
		dns cloudflare {env.CF_DNS_API_TOKEN}
		resolvers 1.1.1.1 1.0.0.1
	}
	# Caddy forwards the WebSocket connection used by Kuma's dashboard.
	reverse_proxy uptime-kuma.railway.internal:3001 {
		header_up X-Forwarded-For {http.request.remote.host}
		header_up X-Forwarded-Host uptime.internal.t-apps.nl
		header_up X-Forwarded-Proto https
	}
}

# This listener is reachable only inside Railway and from our tunnel.
# n8n workflows validate provider authentication; Kuma validates each push token.
http://:8080 {
	# Railway's internal readiness check. Cloudflare ingress does not publish it.
	handle /healthz {
		rewrite * /healthz/readiness
		reverse_proxy n8n.railway.internal:5678
	}
	@webhook {
		host hooks.t-apps.nl
		path /webhook/* /webhook-test/* /webhook-waiting/*
	}
	handle @webhook {
		reverse_proxy n8n.railway.internal:5678 {
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
			header_up X-Forwarded-Host hooks.t-apps.nl
			header_up X-Forwarded-Proto https
		}
	}
	@kumaPush {
		host uptime-hooks.t-apps.nl
		path_regexp kumaPush ^/api/push/[A-Za-z0-9_-]+$
	}
	handle @kumaPush {
		header Cache-Control "no-store"
		reverse_proxy uptime-kuma.railway.internal:3001 {
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
			header_up X-Forwarded-Host uptime-hooks.t-apps.nl
			header_up X-Forwarded-Proto https
		}
	}
	handle {
		respond "Not found" 404
	}
}
